FROM ubuntu:latest

RUN apt-get update

RUN apt-get install -y make &&\
    apt-get install -y g++ &&\
    apt-get install -y libz-dev &&\
    apt-get install -y gfortran &&\
    apt-get install -y bison flex &&\
    apt-get install -y mpich && \ 
    apt-get install -y vim nano dos2unix

RUN mkdir /app && mkdir /app/workspace

COPY ../../ /app/dock6

RUN find /app/dock6/install /app/dock6/src -type f -exec dos2unix -q {} + && \
    chmod +x /app/dock6/install/configure && \
    chmod +x /app/dock6/install/docker/*.sh && \
    sed -i 's/CFLAGS=      /CFLAGS=      -std=gnu89 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=implicit-int /' /app/dock6/install/gnu* && \
    sed -i 's/OCFLAGS=     /OCFLAGS=     -std=gnu89 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=implicit-int /' /app/dock6/install/gnu* && \
    sed -i 's/FFLAGS=      /FFLAGS=      -fallow-argument-mismatch /' /app/dock6/install/gnu*

RUN cd /app/dock6/install && \
        make -i distclean && \
        ./configure gnu && \
        make install || true

RUN cd /app/dock6/src/dock/nab &&\
    make clean &&\
    make copy.lex.mm_options.c &&\
    make -e DOCKBUILDFLAGS='-Dflex -std=gnu89 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=implicit-int' all &&\
    cd /app/dock6/install &&\
    make install

RUN cd /app/dock6/install && \
        make -i cleandock && \
        ./configure gnu.parallel && \
        make dock || true

RUN cd /app/dock6/src/dock/nab &&\
    make clean &&\
    make copy.lex.mm_options.c &&\
    make -e DOCKBUILDFLAGS='-Dflex -std=gnu89 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=implicit-int' all &&\
    cd /app/dock6/install &&\
    make dock

ENV PATH="/app/dock6/bin:$PATH"

RUN chmod +x /app/dock6/bin/*
RUN sed -i 's/\r$//' /app/dock6/install/docker/dispatcher_windows.sh && chmod +x /app/dock6/install/docker/dispatcher_windows.sh

ENTRYPOINT ["/app/dock6/install/docker/dispatcher_windows.sh"]
